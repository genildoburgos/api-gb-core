# ==================================
# Application Configuration
# ==================================
# A porta em que a aplicação NestJS irá rodar.
PORT=3000

# ==================================
# Security (JWT)
# ==================================
# Um segredo longo e aleatório para assinar os tokens JWT.
JWT_SECRET=your_super_secret_for_jwt

# O tempo de expiração do token (ex: 60s, 1h, 7d).
JWT_EXPIRES_IN=1h

# ==================================
# AWS Credentials
# ==================================
# A região da AWS onde seus serviços estão localizados.
AWS_REGION=us-east-2

# Sua chave de acesso da AWS.
PROVIDER_ACCESS_KEY_ID=your_aws_access_key_id

# Seu segredo da chave de acesso da AWS.
PROVIDER_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Opcional: Usado apenas para credenciais temporárias da AWS (IAM Role).
# Deixe em branco se estiver usando um usuário IAM permanente.
AWS_SESSION_TOKEN=

# ==================================
# AWS Services
# ==================================
# O nome do seu bucket no S3 onde os arquivos serão armazenados.
PROVIDER_BUCKET=bucket-d03-compasstore-upload

# O endpoint para o DynamoDB. Para desenvolvimento local com Docker, use o nome do serviço.
# Para produção na AWS, comente ou remova esta linha.
DYNAMODB_ENDPOINT=http://dynamodb-local:8000

# Caso true o sistema prossegue normalmente com o cadastro caso false boloqueia o cadastro de novos usuario
# para bloquear cadastro público e exigir uma chave secreta de administrador
ALLOW_PUBLIC_REGISTRATION=true

# chave secreta de acesso para criar novos usuários caso ALLOW_PUBLIC_REGISTRATION esteja false
# ATENÇÃO: Em produção, altere este valor para um segredo forte e único
ADMIN_REGISTRATION_SECRET=change-this-admin-registration-secret

#Infra
TUNNEL_TOKEN=your_tunnel_token